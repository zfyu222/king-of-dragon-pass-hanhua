
//+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
//                     Speed Segments
//+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        CIwUIElement
        {
            name "ExpSpeedSeg"
            sizeMin { 128 29 }
            sizeMax { 128 29 }
            CIwUILayout
            {
                element { name "SpdSegBg" }
                CIwUILayoutHorizontal
                {
                    element { name "SpdSegLeft" }
                    element { name "SpdSegMiddle" }
                    element { name "SpdSegRight" }
                }
            }
            CIwUIImage
            {
                name "SpdSegBg"
                texture Speed_BtnBase
                drawableType "image"
                sizeMin { 128 29 }
                sizeMax { 128 29 }
            }
            CIwUIButton
            {
                sizeToContent true
                sizeMin { 43 29 }
                sizeMax { 43 29 }
                margin { 0 0 }
                name "SpdSegLeft"
                style <button>
                OnButtonClick {  SegmentHolder::segmentTapped }
                buttonUp 
                {
                    drawableType "image"
                    texture Speed_BtnLeft

                }
                buttonDown
                {
                    drawableType "image"
                    texture Speed_BtnLeft
                }
                focus ""
            }
             CIwUIButton
            {
                sizeToContent true
                sizeMin { 42 29 }
                sizeMax { 42 29 }
                margin { 0 0 }
                name "SpdSegMiddle"
                style <button>
                OnButtonClick { SegmentHolder::segmentTapped }
                buttonUp 
                {
                    drawableType "image"
                    texture Speed_BtnMiddle

                }
                buttonDown
                {
                    drawableType "image"
                    texture Speed_BtnMiddle
                }
                focus ""
            }
            CIwUIButton
            {
                sizeToContent true
                sizeMin { 43 29 }
                sizeMax { 43 29 }
                margin { 0 0 }
                name "SpdSegRight"
                style <button>
                OnButtonClick {  SegmentHolder::segmentTapped }
                buttonUp 
                {
                    drawableType "image"
                    texture Speed_BtnRight

                }
                buttonDown
                {
                    drawableType "image"
                    texture Speed_BtnRight
                }
                focus ""
            }
        }




CIwUIElement
{
	name			"ExploreController"
     sizeMin { 560 160 }
     sizeMax { 560 160 }
    sizeToContent true
    sizeToSpace true
    
    CIwUILayout
    {
        element { name "CCBackGround" }
        CIwUILayoutHorizontal
        {
            CIwUILayoutSpacer { sizeMin { 30 0} sizeMax {30 0} }
            CIwUILayoutVertical
            {
                 CIwUILayoutSpacer { sizeMin { 0 30} sizeMax {0 30} }
                 element { name "ExpleaderImg" alignH "centre" }
                 CIwUILayoutSpacer { sizeMin { 0 5} sizeMax {0 5} }
                 element { name "ExpleaderName" }
            }
            CIwUILayoutSpacer { sizeMin { 10 0} sizeMax {10 0} }
            CIwUILayoutVertical
            {
                 CIwUILayoutSpacer { sizeMin { 0 10} sizeMax {0 10} }
                 element { name "Expweaponthanes" }
                 element { name "Expfootmen" }
            }
            CIwUILayoutSpacer { sizeMin { 10 0} sizeMax {10 0} }
            CIwUILayoutVertical
            {
                CIwUILayoutSpacer { sizeMin { 0 30} sizeMax {0 30} }
                 element { name "ExpSpeedSegP" }
                 CIwUILayoutSpacer { sizeMin { 0 30} sizeMax {0 30} }
                 CIwUILayoutHorizontal
                 {
                    element { name "ExpSend" }
                    CIwUILayoutSpacer { sizeMin { 10 0} sizeMax { 10 0 } }
                    element { name "ExpCancel" }
                 }
            }
        }
    }

