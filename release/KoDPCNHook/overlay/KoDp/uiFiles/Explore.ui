    CIwUIImage
    {
        name "CCBackGround"
        //style <bg>
        drawableType "image"
        sizeToSpace true
        sizeToContent   true
        texture Clear64x64
        sizeMin { 560 160 }
        sizeMax { 560 160 }
    }

        CIwUIElement
        {
            sizeMin { 231, 60 }
            sizeToContent true
            name "Expweaponthanes"
        }
        CIwUIElement
        {
            sizeMin { 231, 60 }
            sizeToContent true
            name "Expfootmen"
        }
        CIwUIButton
        {
            style <Btn_37x105>
            colour { 255 255 255 255 }
            name "ExpleaderName"
            caption "领袖"
            OnButtonClick {  MapController::chooseLeader }
        }

        CIwUIButton
        {
            name "ExpleaderImg"
            sizeToContent true
            sizeMin { 38 50 }
            sizeMax { 38 50 }
            margin { 0 0 }
            style <button>
            OnButtonClick {  MapController::handleLeaderTap }
            buttonUp 
            {
                drawableType "image"
                texture craft1m

            }
            buttonDown
            {
                drawableType "image"
                texture craft1m
            }
            focus ""
        }


        CIwUIButton
        {
            name "ExpSend"
            style <Btn_45x91>
            caption "发送"
            OnButtonClick {  MapController::goExploring }
        }
        CIwUIButton
        {
            name "ExpCancel"
            style <Btn_45x44>
            caption ""
            OnButtonClick {  MapController::cancelExploreDialog }
            CIwUIImage
            {
                pos { 6 6 }
               // name "MCresultButX"
                sizeToContent true
                texture CloseX
                sizeMin { 32 32 }
                sizeMax { 32 32 }
            }
        }

        CIwUIElement
        {
            name "ExpSpeedSegP"
            sizeMin { 128 29 }
            sizeMax { 128 29 }
            sizeToContent true
        }

}
