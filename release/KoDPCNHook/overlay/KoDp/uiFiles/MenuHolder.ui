CIwUIPropertySet
{
	name	<MHbutton>
	style	<button>
    buttonUp {
        drawableType "image"
        texture Clear64x64
    }
    buttonDown ""
    focus ""
    textColour { 103 56 33 255 }
    downCaptionColour { 255 255 255 255 }
    alignH "left"
    alignV "top"
    margin { 42 8 }
    sizeMin { 240 37 }
    sizeMax { 240 37 }
    font "Lorenzo19pt"
}


CIwUIElement
{
	name			"MenuHolder"

    sizeToContent true
    sizeToSpace true
    sizeMin { 240 800 }
    sizeMax { 240 800 }
    CIwUILayoutVertical
    {
        element { name "MHFireSeason" alignH "left" }
        CIwUILayoutHorizontal
        {
            CIwUILayoutSpacer { sizeMin {10 0} sizeMax {10 0} }
//            CIwUILayoutVertical
//            {
