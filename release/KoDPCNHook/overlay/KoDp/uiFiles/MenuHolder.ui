//+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
//                     Bottom View
//+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    CIwUIElement
    {
        name "CCBottomView"
        sizeMin { 815 200 }
        sizeMax { 950 250 }

        CIwUILayoutHorizontal
        {

            CIwUILayoutVertical
            {
                CIwUILayoutSpacer { sizeMin {0 20} sizeMax {0 50} }
                element { name "SacredAdviceView" }
                CIwUILayoutSpacer { sizeMin {0 10} sizeMax {0 20} }
                CIwUILayoutHorizontal
                {
                    CIwUILayoutSpacer { sizeMin {10 0} sizeMax {10 0} }
                    element { name "SacredGridLabels" }
                }
            }
            CIwUILayoutVertical
            {
                sizeToSpace true    
                sizeToContent true
                element { name "CCBlessing" }
                
            }
        }
        CIwUIElement
        {
            name "SacredAdviceView"
            sizeMin { 640 104 }
            sizeMax { 640 104 }

        }
       

    }

