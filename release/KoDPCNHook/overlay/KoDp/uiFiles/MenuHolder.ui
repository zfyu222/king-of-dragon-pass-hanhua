        }
    }
    CIwUIImage
    {
        name "MHCurrentItem"
        sizeToContent true
        texture Selection_1
    }

//+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
//                     Season Image
//+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    CIwUIImage
    {
        sizeToContent true
        name "MHFireSeason"
        texture FireSeason
        CIwUILayout
        {

            CIwUILayoutVertical
            {
//                CIwUILayoutSpacer { sizeMin {0 00} sizeMax {0 10} }
                element { name "MHSeasonsScroll" }

				CIwUILayoutSpacer { sizeMin {0 144} sizeMax {0 144} }
				element { name "MHPlayerName" alignH "centre" }
				CIwUILayoutSpacer { sizeMin {0 -10} sizeMax {0 -10} }
            }
        }

//Seasons Scroll
        CIwUIImage
        {
            sizeToContent false
            sizeMax { 186 75 }
            name "MHSeasonsScroll"
            texture Seasons_scrollPaper
            CIwUILayoutVertical
            {
                alignV "middle"
                CIwUILayoutSpacer { sizeMin {0 6} sizeMax {0 6} }
                CIwUILayoutHorizontal
                {

                    sizeToContent false
                    element { name "MHStorm" alignH "right" alignV "middle" }
                   // CIwUILayoutSpacer { sizeMin {51 0} sizeMax {51 0} }
					element { name "MHSeasonWheel" alignH "centre" alignV "middle" }
					element { name "MHSeason" alignH "left" alignV "middle"}

                }
                CIwUILayoutHorizontal
                {
                    sizeToContent true
                    CIwUILayoutSpacer { sizeMin {53 0} sizeMax {53 0} }
					element { name "MHData" alignH "left" }
                }
            }
            CIwUILabel
            {
                name "MHStorm"
                style	<label_large>
				margin { 0 0 }
                font "DutchMediaeval16" //DutchMediaevalBook15
                textColour { 103 56 33 255 }
                caption "斯特罗姆"
                alignH "right"
                sizeMin { 58, 25 }
                sizeMax { 58, 25 }
            }

            CIwUILabel
            {
                name "MHSeason"

                style	<label_large>
                margin { 0 0 }
                alignH "left"
                font "DutchMediaeval16" //DutchMediaevalBook15
                textColour { 103 56 33 255 }
                caption "季节"
				sizeMin { 58, 25 }
				sizeMax { 58, 25 }
            }
            CIwUIButton
            {
                sizeToContent false
                pos { 23 0 }
                sizeMax { 51 52 }
                sizeMin { 51 52 }
               // alignH "centre"
               // alignV "middle"
                name "MHSeasonWheel"
                style <button>
                //font "font_medium"
                buttonUp 
                {
                    drawableType "image"
                    texture SeasonWheel
                }
                buttonDown
                {
                    drawableType "image"
                    texture SeasonWheel
                }
                focus ""
                caption ""
                OnButtonClick { ManagementController::seasonWheel }
            }
             CIwUILabel
            {
                alignH "centre"
                name "MHData"
                style	<label_large>
                font "Trebuchet27"
                textColour { 123 73 45 255 }
                sizeMin { 60 30 }
                sizeMax { 60 30 }
                caption "1330"
            }

        } //Seasons Scroll
        
        CIwUILabel
        {
            alignH "centre"
            name "MHPlayerName"
            style	<StandartLabel>
            caption "阿拉科林"
            oneLine true
        }
    }
