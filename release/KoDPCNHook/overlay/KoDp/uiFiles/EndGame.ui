CIwUIElement
{
    name "LostController"
    CIwUILayoutHorizontal
    {
        CIwUILayoutSpacer { sizeMin { 376 0} sizeMax {376 0} }
        CIwUILayoutVertical
        {
            spacing 40
            CIwUILayoutSpacer { sizeMin { 0 180} sizeMax {0 180} }
            CIwUILayoutHorizontal
            {
                element { name "showSaga" }
