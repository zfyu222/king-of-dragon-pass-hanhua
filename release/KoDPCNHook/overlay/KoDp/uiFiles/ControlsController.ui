        CIwUIButton
        {
            sizeToContent true
            sizeMin { 155 41 }
            sizeMax { 155 41 }
            name "CntCDebugInfoBut"
            style <button>
            visible "true"
            font "font_medium"
            caption "调试窗口"
            OnButtonClick { ControlsController::showDebugWindow }
            buttonUp ""
            buttonDown ""
            focus ""
        }

    }

}
