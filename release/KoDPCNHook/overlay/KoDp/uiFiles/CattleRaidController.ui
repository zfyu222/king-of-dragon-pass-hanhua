            ZoomingScroll
            {

                name "MapScroll"
                sizeToContent   true
                sizeMin { 519 268 }
                sizeMax { 519 268 }

                CIwUILayout
                {

                }
            }
        }

    }

    //****
    CIwUIButton
    {
        name "FCcloseBut"
        style <Btn_37x37>
        caption ""
        alignH "right"
        OnButtonClick { ManagementController::cancelDialog }
        CIwUIImage
        {
            name "FCcloseImg"
            sizeToContent true
            texture CloseX
            pos { 2 2 }
        }
    }
    
    CIwUIButton
    {
        name "FoodCrecruitBut"
        enabled "false"
        style <Btn_45x122>
        caption "劫牛袭击"
        OnButtonClick {  CattleRaidController::raid }
    }
    
    CIwUIElement
    {
        name "FCAdviceView"
        sizeMin { 640 104 }
        sizeMax { 640 104 }

    }
    
