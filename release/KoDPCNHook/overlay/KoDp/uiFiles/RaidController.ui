

CIwUIElement
{
	name			"RaidController"
        sizeMin { 1280 800 }
        sizeMax { 1280 800 }
    sizeToContent true
    sizeToSpace true
    
    CIwUILayoutHorizontal
    {
        CIwUILayoutSpacer { sizeMin { 180 0} sizeMax {180 0} }
        CIwUILayoutVertical
        {

            CIwUILayoutSpacer { sizeMin { 0 533} sizeMax {0 533} }
