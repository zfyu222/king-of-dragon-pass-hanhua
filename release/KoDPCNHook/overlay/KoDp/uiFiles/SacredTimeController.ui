    CIwUIElement 
    {
        name "SacredGridLabels"
		position { -20 0 }
        CIwUILayoutGrid
        {
            name ""
            column { widthMin 120 widthMax 140 }
            column { widthMin 120 widthMax 140 }
            column { widthMin 120 widthMax 140 }
            row { }
            row { }
            element { name "SacredCows" row 0 column 0 }
            element { name "SacredFood" row 0 column 1 }
            element { name "SacredPopulation" row 0 column 2 }
            element { name "SacredGoods" row 1 column 0 }
            element { name "SacredMagic" row 1 column 1 }
            element { name "SacredWeaponthanes" row 1 column 2 }
        }
        QuantityLabel
        {
            name "SacredCows"
