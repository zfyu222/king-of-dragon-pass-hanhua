                    sizeMin {100 30}
                    sizeMax {100 30}
                    margin {0 0}
                    caption "庄稼"
                }
                CCheckBox
                {
                    name "SacredCrops0"
                    style <checkbox_sacred>
                    checked "false"
                    OnCheckboxChecked { SacredTimeController::checkboxTapped }
                }
                CCheckBox
                {
                    name "SacredCrops1"
                    style <checkbox_sacred>
                    checked "false"
