CIwUIElement
{
	name			"SacredTimeController"

    sizeToContent true
    sizeToSpace true

    CIwUILayout
	{
        sizeToSpace	true
     //   element { name "SacredBackGround" }
        CIwUILayoutHorizontal
        {
            sizeToSpace	true
            sizeToContent true
            CIwUILayoutSpacer { sizeMin {3 0} sizeMax {3 0} }
            CIwUILayoutVertical
            {
                CIwUILayoutSpacer { sizeMin {0 7} sizeMax {0 7} }
                element { name "SacredTimeImage" }
                CIwUILayoutSpacer { sizeMin {0 30} sizeMax {0 30} }
                CIwUILayoutHorizontal
                {
                    CIwUILayoutSpacer { sizeMin {5 0} sizeMax {5 0} }
                    CIwUILayoutVertical
                    {
                        element { name "SacredrecapHeading" }
                        element { name "SacredrecapScroller" }
                    }
                }
            }
            CIwUILayoutSpacer { sizeMin {10 0} sizeMax {10 0} }
            CIwUILayoutVertical
            {
                name "SacredLayoutVertical"
                sizeMin { 930 800 }
                sizeToSpace	true
                sizeToContent true
                 CIwUILayoutSpacer { sizeMin {0 10} sizeMax {0 10} }
                CIwUILayoutHorizontal
                {
                    CIwUILayoutVertical
                    {
                        element { name "SacredForecast"}
                        element { name "SacredScrollerForecast"}
                    }
                    CIwUILayoutSpacer { sizeMin {90 0} sizeMax {90 0} }
                    element { name "SacredGridCheckBox" }
                }
                CIwUILayoutSpacer { sizeMin {0 30} sizeMax {0 30} }
                element { name "SacredAdviceView" }
                CIwUILayoutSpacer { sizeMin {0 10} sizeMax {0 10} }
                element { name "SacredGridLabelsView" }
              // element { name "SacredImageProceed" alignH "right" }

            }
        }
    }
    CIwUIImage
    {
        name "SacredBackGround"
        //style <bg>
        drawableType "image"
        sizeToSpace true
        sizeToContent   true
        texture Clear64x64
        sizeMin { 1280 800 }
        sizeMax { 1280 800 }
    }
    CIwUIElement
    {
        name "SacredGridLabelsView"
        sizeMin { 600 50 }
    }

    CIwUIImage
    {
        name "SacredImageProceed"
        
        texture SacredTime_bg2
        sizeMax { 263 207 }
        sizeMin { 263 207 }
        position { 1017 525 }
         alignH "right"
         

        CIwUIButton
        {
            position { 70 160 }
            alignH "centre"
            alignV "middle"
            name "SacredButtonProceed"
            style <Btn_45x122>
            caption "继续"
            OnButtonClick { SacredTimeController::proceed }
        }
    }

//+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
//                      Right Top Site
//+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        CIwUILabel
        {
            name "SacredForecast"
            style	<ParchementLabel>
            caption "预测"
        }
        CCommonScrollView
        {
            alignV "top"
            name "SacredScrollerForecast"
            sizeMax  { 324 357 }
            sizeMin  { 324 357 }
            CIwUILayoutVertical
            {
                sizeToSpace true
                sizeToContent true
                element { name "ForecastWraper" }
            }
            CIwUIElement
            {
                name "ForecastWraper"
                CIwUILabel
                {
                    name "SacredForecastText"
                    style	<label_medium>
                    font "font_medium"
                    textColour { 0 0 0 255 }
                    caption ""
                    margin { 0 0 }
                }
            }
        }
//+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
//                      Grid With CheckBoxes
//+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        CIwUIElement 
        {
            name "SacredGridCheckBox"
            CIwUILayoutGrid
            {
                name ""
                column { widthMin 120 widthMax 140 }
                column { widthMin 120 widthMax 140 }
                row { }
                row { }
                row { }
                row { }
                row { }
                row { }
                element { name "SacredGridMagic" row 0 column 0 }
                element { name "SacredGridReserve" row 0 column 1 }
                element { name "SacredCrops" row 1 column 0 }
                element { name "SacredMysteries" row 1 column 1 }
                element { name "SacredDiplomacy" row 2 column 0 }
                element { name "SacredQuests" row 2 column 1 }
                element { name "SacredHealth" row 3 column 0 }
                element { name "SacredTrade" row 3 column 1 }
                element { name "SacredHerds" row 4 column 0 }
                element { name "SacredWar" row 4 column 1 }
                element { name "SacredDestiny" row 5 column 0 }
                element { name "SacredHeroism" row 5 column 1 }


            }
            CIwUILabel
            {
                name "SacredGridMagic"
