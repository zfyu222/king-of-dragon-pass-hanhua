
CIwUIPropertySet 
{
	name "<checkbox_style_sacred>"
//: extraclass "IIwUIDrawable"
	drawableType "image"
	texture "Checkbox"
}
CIwUIPropertySet 
{
	name "<checkbox_style_sacred_cross>"
//: extraclass "IIwUIDrawable"
	drawableType "image"
	texture "CheckboxSelected"

}
CIwUIPropertySet
{

	name "<checkbox_sacred>"
    style <checkbox>
    boxStyle <checkbox_style_sacred>
	crossStyle <checkbox_style_sacred_cross>
    focus ""
    boxSize  { 32 32 }
    sizeMin { 32 32 }
    sizeMax { 32 32 }
    alignH "left"

    margin { 8 145 }
    textColour  { 104 56 33 255 }
    font "DutchMediaeval21"

}

