//+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
//                      Left Site
//+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        CIwUILabel
        {
            name "SacredrecapHeading"
            style	<ParchementLabel>
            caption "去年"
        }
        CCommonScrollView
        {

            name "SacredrecapScroller"
            sizeMin  { 353 400 }
            sizeMax  { 353 400 }
            CIwUILayoutVertical
            {
                element { name "RecapWraper" }
            }
             CIwUIElement
            {
                name "RecapWraper"
                CIwUILabel
                {
                    name "SacredrecapText"
                    style	<label_medium>
                    font "font_medium"
                    textColour { 0 0 0 255 }
                    caption "您的"
                    margin { 0  0 }
                    sizeMin  { 353 200 }
                }
            }

        }

        //Reputation Image
        CIwUIImage
        {
            name "SacredTimeImage"
            style <bg>
    //        sizeToSpace false
            sizeToContent   true
            sizeMax { 247 265 }
            texture clanType_Balanced
            CIwUILayout
            {
                CIwUILayoutVertical
                {
                    CIwUILayoutHorizontal
                    {
                        CIwUILayoutSpacer { sizeMin { 12  0 } sizeMax { 12 0 } }
                        element { name "SacredYear" }
                        CIwUILayoutSpacer { sizeMin { 8  0 } sizeMax { 8 0 } }
                        element { name "SacredSeason" }
                    }
                    CIwUILayoutSpacer { sizeMin { 0  110 } sizeMax { 0 110 } }
                    element { name "SacredReputation" alignH "centre"}
                    element { name "SacredReputationArc" alignH "centre" }
//                    CIwUILayoutSpacer { sizeMin { 0 40 } sizeMax { 0 40 } }
                    CIwUILayoutHorizontal
                    {
                        element { name "SacredReputationMin" }
                        CIwUILayoutSpacer { sizeMin {62 0} sizeMax {62 0} }
                        element { name "SacredReputationMax" }
                    }
                }
            }
            CIwUILabel
            {
                name "SacredYear"
                style	<ParchementLabel>
                caption "1330"
            }
            CIwUILabel
            {
                name "SacredSeason"
                style	<ParchementLabel>
                caption "神圣时间"
            }
            CIwUILabel
            {
                name "SacredReputation"
                style	<ParchementLabel>
                caption "声望"
            }
            CIwUILabel
            {
                name "SacredReputationMin"
                style	<StandartLabel>
                caption "拾柴人"
            }
            CIwUILabel
            {
                name "SacredReputationMax"
                style	<StandartLabel>
                caption "国王"
            }
            CIwUIImage
            {
                name "SacredReputationArc"
                sizeToContent   true
                texture arc
            }
        }

        CIwUIElement
        {
            name "SacredAdviceView"
            sizeMin { 640 104 }
            sizeMax { 640 104 }

        }
